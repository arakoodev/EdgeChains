{
  "name": "nexusflow",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "vitest run",
    "test:ci": "vitest run --run",
    "migrate": "node --loader ts-node/esm migrate.ts",
    "workers": "tsx start-workers.ts",
    "dev:full": "npm run migrate && concurrently \"npm run workers\" \"npm run dev\"",
    "docker:up": "bash ./scripts/compose.sh up -d",
    "docker:down": "bash ./scripts/compose.sh down -v",
    "docker:logs": "bash ./scripts/compose.sh logs -f",
    "docker:wait": "bash ./scripts/wait-services.sh",
    "e2e": "bash ./scripts/e2e.sh",
    "allinone:build": "bash ./scripts/build-allinone.sh",
    "allinone:run": "bash ./scripts/run-allinone.sh",
    "allinone:dev": "bash ./scripts/dev-allinone.sh"
  },
  "dependencies": {
    "next": "14.2.3",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "bullmq": "^5.2.3",
    "pg": "^8.11.3",
    "ioredis": "^5.3.2",
    "reactflow": "^11.8.9",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "typescript": "^5.3.3",
    "@types/node": "^20.14.1",
    "vitest": "^1.5.3",
    "ts-node": "^10.9.1",
    "pg-mem": "^2.1.0",
    "ioredis-mock": "^8.9.0",
    "@types/react": "^18.2.60",
    "@types/pg": "^8.10.1",
    "@types/uuid": "^9.0.7",
    "concurrently": "^8.2.0",
    "tsx": "^4.7.0"
  },
  "type": "module"
}
