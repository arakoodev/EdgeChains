+interface MockServerHandle {
+    url: string;
+    hits: number;
+    requests: Array<{ url: string; headers: http.IncomingHttpHeaders; body: any }>;
+    close: () => Promise<void>;
+}
+
+async function startMockServer(
+    handler: (
+        req: http.IncomingMessage,
+        body: any,
+        res: http.ServerResponse,
+        state: { hits: number }
+    ) => void | Promise<void>
+): Promise<MockServerHandle> {
+    const state = { hits: 0 };
+    const requests: Array<{ url: string; headers: http.IncomingHttpHeaders; body: any }> = [];
+
+    const server = http.createServer((req, res) => {
+        const chunks: Buffer[] = [];
+        req.on("data", (c) => chunks.push(c));
+        req.on("end", async () => {
+            state.hits += 1;
+            const rawText = Buffer.concat(chunks).toString("utf8");
+            let parsed: any = rawText;
+            try {
+                parsed = rawText ? JSON.parse(rawText) : {};
+            } catch {
+                parsed = rawText;
+            }
+            requests.push({
+                url: req.url || "/",
+                headers: req.headers,
+                body: parsed,
+            });
+            try {
+                await handler(req, parsed, res, state);
+            } catch (err: any) {
+                if (!res.headersSent) {
+                    res.writeHead(500, { "content-type": "application/json" });
+                    res.end(JSON.stringify({ error: err?.message || "mock error" }));
+                }
+            }
+        });
+    });
+
+    await new Promise<void>((resolve) => {
+        server.listen(0, "127.0.0.1", () => resolve());
+    });
+
+    const address = server.address();
+    if (!address || typeof address === "string") {
+        throw new Error("Failed to bind mock server");
+    }
+
+    return {
+        url: `http://127.0.0.1:${address.port}/v1`,
+        get hits() {
+            return state.hits;
+        },
+        requests,
+        close: () =>
+            new Promise<void>((resolve, reject) => {
+                server.close((err) => (err ? reject(err) : resolve()));
+            }),
+    };
+}
+
+function sendJson(res: http.ServerResponse, status: number, payload: unknown): void {
+    res.writeHead(status, { "content-type": "application/json" });
+    res.end(JSON.stringify(payload));
+}
